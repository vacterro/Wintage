@OBSThemeMeta {
    name: 'Wintage Dark Golden (Win95)';
    id: 'com.wintage.OBS';
    extends: 'com.obsproject.Yami.Classic';
    author: 'Wintage';
    dark: 'true';
}

@OBSThemeVars {
    --grey1: #D3B57A;
    --grey2: #634B2B;
    --grey3: #5A4324;
    --grey4: #4A341B;
    --grey5: #3A2616;
    --grey6: #24170C;
    --grey7: #342012;
    --grey8: #1C1208;

    --blue1: #D3B57A;
    --blue2: #008080;
    --blue3: #006060;
    --red1: #D37676;
    --red2: #D37676;
    --red3: #963030;
    --green3: #5B9630;
    --yellow3: #969630;

    --bg_window: #342012;
    --bg_base: #3A2616;
    --bg_preview: #24170C;
    --primary: #5A4324;
    --primary_light: #634B2B;
    --primary_lighter: #D3B57A;
    --primary_dark: #006060;
    --primary_darker: #1C1208;
    --warning: #969630;
    --danger: #963030;
    --text: #E2CA95;
    --text_light: #C5AB6E;
    --text_muted: #95804C;
    --text_disabled: #95804C;
    --text_inactive: #C5AB6E;

    --border_color: #1C1208;
    --border_radius: 0px;
    --border_radius_small: 0px;
    --border_radius_large: 0px;
    --highlight_width: 1px;
    --highlight_color: #D3B57A;
    --border_highlight: #D3B57A;

    --input_bg: #4A341B;
    --input_bg_hover: #634B2B;
    --input_bg_focus: #24170C;
    --list_item_bg_selected: #5A4324;
    --list_item_bg_hover: #634B2B;
    --input_border: #665033;
    --input_border_hover: #826941;
    --input_border_focus: #D3B57A;
    --button_bg: #5A4324;
    --button_bg_hover: #634B2B;
    --button_bg_down: #4A341B;
    --button_bg_disabled: #3A2616;
    --button_border: #5A4324;
    --button_border_hover: #826941;
    --button_border_focus: #D3B57A;
    --tab_bg: #5A4324;
    --tab_bg_hover: #634B2B;
    --tab_bg_down: #4A341B;
    --tab_bg_disabled: #3A2616;
    --tab_border: #665033;
    --tab_border_hover: #826941;
    --tab_border_focus: #D3B57A;
    --tab_border_selected: #5A4324;
    --scrollbar_handle: #5A4324;
    --scrollbar_bg: #3A2616;
    --scrollbar_hover: #634B2B;
    --scrollbar_down: #4A341B;
    --scrollbar_border: #1C1208;
}

QWidget {
    font-family: Verdana;
    font-size: 12px;
}

QPushButton,
QToolButton {
    border: 2px solid;
    border-color: #826941 #1C1208 #1C1208 #826941;
    border-radius: 0px;
}

QPushButton:pressed,
QPushButton:checked,
QToolButton:pressed,
QToolButton:checked {
    border-color: #1C1208 #826941 #826941 #1C1208;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    border: 2px solid;
    border-color: #1C1208 #826941 #826941 #1C1208;
    border-radius: 0px;
}
