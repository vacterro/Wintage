@OBSThemeMeta {
    name: 'Wintage Dark 2 (OLED)';
    id: 'com.wintage.OBS';
    extends: 'com.obsproject.Yami.Classic';
    author: 'Wintage';
    dark: 'true';
}

@OBSThemeVars {
    --grey1: #FFFFFF;
    --grey2: #1C1C1C;
    --grey3: #141414;
    --grey4: #0A0A0A;
    --grey5: #000000;
    --grey6: #000000;
    --grey7: #000000;
    --grey8: #1A1A1A;

    --blue1: #FFFFFF;
    --blue2: #008080;
    --blue3: #004C4C;
    --red1: #CE4444;
    --red2: #CE4444;
    --red3: #7A2020;
    --green3: #4A7A20;
    --yellow3: #7A7A20;

    --bg_window: #000000;
    --bg_base: #000000;
    --bg_preview: #000000;
    --primary: #141414;
    --primary_light: #1C1C1C;
    --primary_lighter: #FFFFFF;
    --primary_dark: #004C4C;
    --primary_darker: #1A1A1A;
    --warning: #7A7A20;
    --danger: #7A2020;
    --text: #A0A0A0;
    --text_light: #777777;
    --text_muted: #484848;
    --text_disabled: #484848;
    --text_inactive: #777777;

    --border_color: #1A1A1A;
    --border_radius: 0px;
    --border_radius_small: 0px;
    --border_radius_large: 0px;
    --highlight_width: 1px;
    --highlight_color: #FFFFFF;
    --border_highlight: #FFFFFF;

    --input_bg: #0A0A0A;
    --input_bg_hover: #1C1C1C;
    --input_bg_focus: #000000;
    --list_item_bg_selected: #141414;
    --list_item_bg_hover: #1C1C1C;
    --input_border: #333333;
    --input_border_hover: #5C5C5C;
    --input_border_focus: #FFFFFF;
    --button_bg: #141414;
    --button_bg_hover: #1C1C1C;
    --button_bg_down: #0A0A0A;
    --button_bg_disabled: #000000;
    --button_border: #141414;
    --button_border_hover: #5C5C5C;
    --button_border_focus: #FFFFFF;
    --tab_bg: #141414;
    --tab_bg_hover: #1C1C1C;
    --tab_bg_down: #0A0A0A;
    --tab_bg_disabled: #000000;
    --tab_border: #333333;
    --tab_border_hover: #5C5C5C;
    --tab_border_focus: #FFFFFF;
    --tab_border_selected: #141414;
    --scrollbar_handle: #141414;
    --scrollbar_bg: #000000;
    --scrollbar_hover: #1C1C1C;
    --scrollbar_down: #0A0A0A;
    --scrollbar_border: #1A1A1A;
}

QWidget {
    font-family: Verdana;
    font-size: 12px;
}

QPushButton,
QToolButton {
    border: 2px solid;
    border-color: #5C5C5C #1A1A1A #1A1A1A #5C5C5C;
    border-radius: 0px;
}

QPushButton:pressed,
QPushButton:checked,
QToolButton:pressed,
QToolButton:checked {
    border-color: #1A1A1A #5C5C5C #5C5C5C #1A1A1A;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    border: 2px solid;
    border-color: #1A1A1A #5C5C5C #5C5C5C #1A1A1A;
    border-radius: 0px;
}
