@OBSThemeMeta {
    name: 'Wintage Vintage Dark';
    id: 'com.wintage.OBS';
    extends: 'com.obsproject.Yami.Classic';
    author: 'Wintage';
    dark: 'true';
}

@OBSThemeVars {
    --grey1: #738EA6;
    --grey2: #3A3A3A;
    --grey3: #343434;
    --grey4: #2B2B2B;
    --grey5: #1B1B1B;
    --grey6: #121212;
    --grey7: #181818;
    --grey8: #0A0A0A;

    --blue1: #738EA6;
    --blue2: #008080;
    --blue3: #004C4C;
    --red1: #D45D5D;
    --red2: #D45D5D;
    --red3: #7A2020;
    --green3: #4A7A20;
    --yellow3: #7A7A20;

    --bg_window: #181818;
    --bg_base: #1B1B1B;
    --bg_preview: #121212;
    --primary: #343434;
    --primary_light: #3A3A3A;
    --primary_lighter: #738EA6;
    --primary_dark: #004C4C;
    --primary_darker: #0A0A0A;
    --warning: #7A7A20;
    --danger: #7A2020;
    --text: #C0C0C0;
    --text_light: #8E8E8E;
    --text_muted: #646464;
    --text_disabled: #646464;
    --text_inactive: #8E8E8E;

    --border_color: #0A0A0A;
    --border_radius: 0px;
    --border_radius_small: 0px;
    --border_radius_large: 0px;
    --highlight_width: 1px;
    --highlight_color: #738EA6;
    --border_highlight: #738EA6;

    --input_bg: #2B2B2B;
    --input_bg_hover: #3A3A3A;
    --input_bg_focus: #121212;
    --list_item_bg_selected: #343434;
    --list_item_bg_hover: #3A3A3A;
    --input_border: #4D4D4D;
    --input_border_hover: #4A5258;
    --input_border_focus: #738EA6;
    --button_bg: #343434;
    --button_bg_hover: #3A3A3A;
    --button_bg_down: #2B2B2B;
    --button_bg_disabled: #1B1B1B;
    --button_border: #343434;
    --button_border_hover: #4A5258;
    --button_border_focus: #738EA6;
    --tab_bg: #343434;
    --tab_bg_hover: #3A3A3A;
    --tab_bg_down: #2B2B2B;
    --tab_bg_disabled: #1B1B1B;
    --tab_border: #4D4D4D;
    --tab_border_hover: #4A5258;
    --tab_border_focus: #738EA6;
    --tab_border_selected: #343434;
    --scrollbar_handle: #343434;
    --scrollbar_bg: #1B1B1B;
    --scrollbar_hover: #3A3A3A;
    --scrollbar_down: #2B2B2B;
    --scrollbar_border: #0A0A0A;
}

QWidget {
    font-family: Verdana;
    font-size: 12px;
}

QPushButton,
QToolButton {
    border: 2px solid;
    border-color: #4A5258 #0A0A0A #0A0A0A #4A5258;
    border-radius: 0px;
}

QPushButton:pressed,
QPushButton:checked,
QToolButton:pressed,
QToolButton:checked {
    border-color: #0A0A0A #4A5258 #4A5258 #0A0A0A;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    border: 2px solid;
    border-color: #0A0A0A #4A5258 #4A5258 #0A0A0A;
    border-radius: 0px;
}
