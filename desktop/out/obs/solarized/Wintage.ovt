@OBSThemeMeta {
    name: 'Wintage Solarized Dark';
    id: 'com.wintage.OBS';
    extends: 'com.obsproject.Yami.Classic';
    author: 'Wintage';
    dark: 'true';
}

@OBSThemeVars {
    --grey1: #51A2DB;
    --grey2: #2B4F59;
    --grey3: #1B444F;
    --grey4: #073642;
    --grey5: #073642;
    --grey6: #002029;
    --grey7: #002B36;
    --grey8: #001F27;

    --blue1: #51A2DB;
    --blue2: #008080;
    --blue3: #004C4C;
    --red1: #DD7D7D;
    --red2: #DD7D7D;
    --red3: #7A2020;
    --green3: #4A7A20;
    --yellow3: #7A7A20;

    --bg_window: #002B36;
    --bg_base: #073642;
    --bg_preview: #002029;
    --primary: #1B444F;
    --primary_light: #2B4F59;
    --primary_lighter: #51A2DB;
    --primary_dark: #004C4C;
    --primary_darker: #001F27;
    --warning: #7A7A20;
    --danger: #7A2020;
    --text: #93A1A1;
    --text_light: #8D9EA1;
    --text_muted: #426066;
    --text_disabled: #426066;
    --text_inactive: #8D9EA1;

    --border_color: #001F27;
    --border_radius: 0px;
    --border_radius_small: 0px;
    --border_radius_large: 0px;
    --highlight_width: 1px;
    --highlight_color: #51A2DB;
    --border_highlight: #51A2DB;

    --input_bg: #073642;
    --input_bg_hover: #2B4F59;
    --input_bg_focus: #002029;
    --list_item_bg_selected: #1B444F;
    --list_item_bg_hover: #2B4F59;
    --input_border: #586E75;
    --input_border_hover: #36667D;
    --input_border_focus: #51A2DB;
    --button_bg: #1B444F;
    --button_bg_hover: #2B4F59;
    --button_bg_down: #073642;
    --button_bg_disabled: #073642;
    --button_border: #1B444F;
    --button_border_hover: #36667D;
    --button_border_focus: #51A2DB;
    --tab_bg: #1B444F;
    --tab_bg_hover: #2B4F59;
    --tab_bg_down: #073642;
    --tab_bg_disabled: #073642;
    --tab_border: #586E75;
    --tab_border_hover: #36667D;
    --tab_border_focus: #51A2DB;
    --tab_border_selected: #1B444F;
    --scrollbar_handle: #1B444F;
    --scrollbar_bg: #073642;
    --scrollbar_hover: #2B4F59;
    --scrollbar_down: #073642;
    --scrollbar_border: #001F27;
}

QWidget {
    font-family: Verdana;
    font-size: 12px;
}

QPushButton,
QToolButton {
    border: 2px solid;
    border-color: #36667D #001F27 #001F27 #36667D;
    border-radius: 0px;
}

QPushButton:pressed,
QPushButton:checked,
QToolButton:pressed,
QToolButton:checked {
    border-color: #001F27 #36667D #36667D #001F27;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    border: 2px solid;
    border-color: #001F27 #36667D #36667D #001F27;
    border-radius: 0px;
}
