@OBSThemeMeta {
    name: 'Wintage Vintage Classic';
    id: 'com.wintage.OBS';
    extends: 'com.obsproject.Yami.Classic';
    author: 'Wintage';
    dark: 'true';
}

@OBSThemeVars {
    --grey1: #F6F6F6;
    --grey2: #DCDCDC;
    --grey3: #D0D0D0;
    --grey4: #C0C0C0;
    --grey5: #FFFFFF;
    --grey6: #D0D0D0;
    --grey7: #C0C0C0;
    --grey8: #808080;

    --blue1: #5E7A7A;
    --blue2: #008080;
    --blue3: #004C4C;
    --red1: #7A2020;
    --red2: #7A2020;
    --red3: #7A2020;
    --green3: #4A7A20;
    --yellow3: #7A7A20;

    --bg_window: #C0C0C0;
    --bg_base: #FFFFFF;
    --bg_preview: #D0D0D0;
    --primary: #D0D0D0;
    --primary_light: #DCDCDC;
    --primary_lighter: #5E7A7A;
    --primary_dark: #004C4C;
    --primary_darker: #808080;
    --warning: #7A7A20;
    --danger: #7A2020;
    --text: #000000;
    --text_light: #3A3A3A;
    --text_muted: #6A6A6A;
    --text_disabled: #6A6A6A;
    --text_inactive: #3A3A3A;

    --border_color: #808080;
    --border_radius: 0px;
    --border_radius_small: 0px;
    --border_radius_large: 0px;
    --highlight_width: 1px;
    --highlight_color: #5E7A7A;
    --border_highlight: #5E7A7A;

    --input_bg: #C0C0C0;
    --input_bg_hover: #DCDCDC;
    --input_bg_focus: #D0D0D0;
    --list_item_bg_selected: #D0D0D0;
    --list_item_bg_hover: #DCDCDC;
    --input_border: #FFFFFF;
    --input_border_hover: #F6F6F6;
    --input_border_focus: #5E7A7A;
    --button_bg: #D0D0D0;
    --button_bg_hover: #DCDCDC;
    --button_bg_down: #C0C0C0;
    --button_bg_disabled: #FFFFFF;
    --button_border: #D0D0D0;
    --button_border_hover: #F6F6F6;
    --button_border_focus: #5E7A7A;
    --tab_bg: #D0D0D0;
    --tab_bg_hover: #DCDCDC;
    --tab_bg_down: #C0C0C0;
    --tab_bg_disabled: #FFFFFF;
    --tab_border: #FFFFFF;
    --tab_border_hover: #F6F6F6;
    --tab_border_focus: #5E7A7A;
    --tab_border_selected: #D0D0D0;
    --scrollbar_handle: #D0D0D0;
    --scrollbar_bg: #FFFFFF;
    --scrollbar_hover: #DCDCDC;
    --scrollbar_down: #C0C0C0;
    --scrollbar_border: #808080;
}

QWidget {
    font-family: Verdana;
    font-size: 12px;
}

QPushButton,
QToolButton {
    border: 2px solid;
    border-color: #F6F6F6 #808080 #808080 #F6F6F6;
    border-radius: 0px;
}

QPushButton:pressed,
QPushButton:checked,
QToolButton:pressed,
QToolButton:checked {
    border-color: #808080 #F6F6F6 #F6F6F6 #808080;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    border: 2px solid;
    border-color: #808080 #F6F6F6 #F6F6F6 #808080;
    border-radius: 0px;
}
