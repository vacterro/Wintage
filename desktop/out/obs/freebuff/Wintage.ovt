@OBSThemeMeta {
    name: 'Wintage FreeBuff';
    id: 'com.wintage.OBS';
    extends: 'com.obsproject.Yami.Classic';
    author: 'Wintage';
    dark: 'true';
}

@OBSThemeVars {
    --grey1: #89D37A;
    --grey2: #3A4354;
    --grey3: #333B4B;
    --grey4: #28303D;
    --grey5: #202830;
    --grey6: #13181D;
    --grey7: #1B232B;
    --grey8: #0E1116;

    --blue1: #89D37A;
    --blue2: #008080;
    --blue3: #006060;
    --red1: #D27272;
    --red2: #D27272;
    --red3: #963030;
    --green3: #5B9630;
    --yellow3: #969630;

    --bg_window: #1B232B;
    --bg_base: #202830;
    --bg_preview: #13181D;
    --primary: #333B4B;
    --primary_light: #3A4354;
    --primary_lighter: #89D37A;
    --primary_dark: #006060;
    --primary_darker: #0E1116;
    --warning: #969630;
    --danger: #963030;
    --text: #A0E295;
    --text_light: #7AC56E;
    --text_muted: #55954C;
    --text_disabled: #55954C;
    --text_inactive: #7AC56E;

    --border_color: #0E1116;
    --border_radius: 0px;
    --border_radius_small: 0px;
    --border_radius_large: 0px;
    --highlight_width: 1px;
    --highlight_color: #89D37A;
    --border_highlight: #89D37A;

    --input_bg: #28303D;
    --input_bg_hover: #3A4354;
    --input_bg_focus: #13181D;
    --list_item_bg_selected: #333B4B;
    --list_item_bg_hover: #3A4354;
    --input_border: #414958;
    --input_border_hover: #506B5F;
    --input_border_focus: #89D37A;
    --button_bg: #333B4B;
    --button_bg_hover: #3A4354;
    --button_bg_down: #28303D;
    --button_bg_disabled: #202830;
    --button_border: #333B4B;
    --button_border_hover: #506B5F;
    --button_border_focus: #89D37A;
    --tab_bg: #333B4B;
    --tab_bg_hover: #3A4354;
    --tab_bg_down: #28303D;
    --tab_bg_disabled: #202830;
    --tab_border: #414958;
    --tab_border_hover: #506B5F;
    --tab_border_focus: #89D37A;
    --tab_border_selected: #333B4B;
    --scrollbar_handle: #333B4B;
    --scrollbar_bg: #202830;
    --scrollbar_hover: #3A4354;
    --scrollbar_down: #28303D;
    --scrollbar_border: #0E1116;
}

QWidget {
    font-family: Verdana;
    font-size: 12px;
}

QPushButton,
QToolButton {
    border: 2px solid;
    border-color: #506B5F #0E1116 #0E1116 #506B5F;
    border-radius: 0px;
}

QPushButton:pressed,
QPushButton:checked,
QToolButton:pressed,
QToolButton:checked {
    border-color: #0E1116 #506B5F #506B5F #0E1116;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    border: 2px solid;
    border-color: #0E1116 #506B5F #506B5F #0E1116;
    border-radius: 0px;
}
