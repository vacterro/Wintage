@OBSThemeMeta {
    name: 'Wintage Golden Default';
    id: 'com.wintage.OBS';
    extends: 'com.obsproject.Yami.Classic';
    author: 'Wintage';
    dark: 'true';
}

@OBSThemeVars {
    --grey1: #F0D060;
    --grey2: #453D30;
    --grey3: #3D372A;
    --grey4: #332E22;
    --grey5: #232018;
    --grey6: #14120C;
    --grey7: #1A1810;
    --grey8: #100E08;

    --blue1: #F0D060;
    --blue2: #008080;
    --blue3: #004C4C;
    --red1: #D66464;
    --red2: #D66464;
    --red3: #7A2020;
    --green3: #4A7A20;
    --yellow3: #7A7A20;

    --bg_window: #1A1810;
    --bg_base: #232018;
    --bg_preview: #14120C;
    --primary: #3D372A;
    --primary_light: #453D30;
    --primary_lighter: #F0D060;
    --primary_dark: #004C4C;
    --primary_darker: #100E08;
    --warning: #7A7A20;
    --danger: #7A2020;
    --text: #D4C89A;
    --text_light: #9C9371;
    --text_muted: #6E674E;
    --text_disabled: #6E674E;
    --text_inactive: #9C9371;

    --border_color: #100E08;
    --border_radius: 0px;
    --border_radius_small: 0px;
    --border_radius_large: 0px;
    --highlight_width: 1px;
    --highlight_color: #F0D060;
    --border_highlight: #F0D060;

    --input_bg: #332E22;
    --input_bg_hover: #453D30;
    --input_bg_focus: #14120C;
    --list_item_bg_selected: #3D372A;
    --list_item_bg_hover: #453D30;
    --input_border: #5A5040;
    --input_border_hover: #75663D;
    --input_border_focus: #F0D060;
    --button_bg: #3D372A;
    --button_bg_hover: #453D30;
    --button_bg_down: #332E22;
    --button_bg_disabled: #232018;
    --button_border: #3D372A;
    --button_border_hover: #75663D;
    --button_border_focus: #F0D060;
    --tab_bg: #3D372A;
    --tab_bg_hover: #453D30;
    --tab_bg_down: #332E22;
    --tab_bg_disabled: #232018;
    --tab_border: #5A5040;
    --tab_border_hover: #75663D;
    --tab_border_focus: #F0D060;
    --tab_border_selected: #3D372A;
    --scrollbar_handle: #3D372A;
    --scrollbar_bg: #232018;
    --scrollbar_hover: #453D30;
    --scrollbar_down: #332E22;
    --scrollbar_border: #100E08;
}

QWidget {
    font-family: Verdana;
    font-size: 12px;
}

QPushButton,
QToolButton {
    border: 2px solid;
    border-color: #75663D #100E08 #100E08 #75663D;
    border-radius: 0px;
}

QPushButton:pressed,
QPushButton:checked,
QToolButton:pressed,
QToolButton:checked {
    border-color: #100E08 #75663D #75663D #100E08;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    border: 2px solid;
    border-color: #100E08 #75663D #75663D #100E08;
    border-radius: 0px;
}
