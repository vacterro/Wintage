@OBSThemeMeta {
    name: 'Wintage Claude Code';
    id: 'com.wintage.OBS';
    extends: 'com.obsproject.Yami.Classic';
    author: 'Wintage';
    dark: 'true';
}

@OBSThemeVars {
    --grey1: #D1A27C;
    --grey2: #514C3D;
    --grey3: #484436;
    --grey4: #3B362A;
    --grey5: #2E2922;
    --grey6: #1C1914;
    --grey7: #29241D;
    --grey8: #15130F;

    --blue1: #D1A27C;
    --blue2: #008080;
    --blue3: #006060;
    --red1: #D37575;
    --red2: #D37575;
    --red3: #963030;
    --green3: #5B9630;
    --yellow3: #969630;

    --bg_window: #29241D;
    --bg_base: #2E2922;
    --bg_preview: #1C1914;
    --primary: #484436;
    --primary_light: #514C3D;
    --primary_lighter: #D1A27C;
    --primary_dark: #006060;
    --primary_darker: #15130F;
    --warning: #969630;
    --danger: #963030;
    --text: #E0B997;
    --text_light: #C39870;
    --text_muted: #93704E;
    --text_disabled: #93704E;
    --text_inactive: #C39870;

    --border_color: #15130F;
    --border_radius: 0px;
    --border_radius_small: 0px;
    --border_radius_large: 0px;
    --highlight_width: 1px;
    --highlight_color: #D1A27C;
    --border_highlight: #D1A27C;

    --input_bg: #3B362A;
    --input_bg_hover: #514C3D;
    --input_bg_focus: #1C1914;
    --list_item_bg_selected: #484436;
    --list_item_bg_hover: #514C3D;
    --input_border: #555144;
    --input_border_hover: #75644F;
    --input_border_focus: #D1A27C;
    --button_bg: #484436;
    --button_bg_hover: #514C3D;
    --button_bg_down: #3B362A;
    --button_bg_disabled: #2E2922;
    --button_border: #484436;
    --button_border_hover: #75644F;
    --button_border_focus: #D1A27C;
    --tab_bg: #484436;
    --tab_bg_hover: #514C3D;
    --tab_bg_down: #3B362A;
    --tab_bg_disabled: #2E2922;
    --tab_border: #555144;
    --tab_border_hover: #75644F;
    --tab_border_focus: #D1A27C;
    --tab_border_selected: #484436;
    --scrollbar_handle: #484436;
    --scrollbar_bg: #2E2922;
    --scrollbar_hover: #514C3D;
    --scrollbar_down: #3B362A;
    --scrollbar_border: #15130F;
}

QWidget {
    font-family: Verdana;
    font-size: 12px;
}

QPushButton,
QToolButton {
    border: 2px solid;
    border-color: #75644F #15130F #15130F #75644F;
    border-radius: 0px;
}

QPushButton:pressed,
QPushButton:checked,
QToolButton:pressed,
QToolButton:checked {
    border-color: #15130F #75644F #75644F #15130F;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    border: 2px solid;
    border-color: #15130F #75644F #75644F #15130F;
    border-radius: 0px;
}
