@OBSThemeMeta {
    name: 'Wintage Antigravity';
    id: 'com.wintage.OBS';
    extends: 'com.obsproject.Yami.Classic';
    author: 'Wintage';
    dark: 'true';
}

@OBSThemeVars {
    --grey1: #7AD0D3;
    --grey2: #393D55;
    --grey3: #31354D;
    --grey4: #272B3E;
    --grey5: #1F2431;
    --grey6: #12151E;
    --grey7: #1B1F2C;
    --grey8: #0D0F17;

    --blue1: #7AD0D3;
    --blue2: #008080;
    --blue3: #006060;
    --red1: #D06D6D;
    --red2: #D06D6D;
    --red3: #963030;
    --green3: #5B9630;
    --yellow3: #969630;

    --bg_window: #1B1F2C;
    --bg_base: #1F2431;
    --bg_preview: #12151E;
    --primary: #31354D;
    --primary_light: #393D55;
    --primary_lighter: #7AD0D3;
    --primary_dark: #006060;
    --primary_darker: #0D0F17;
    --warning: #969630;
    --danger: #963030;
    --text: #95DEE2;
    --text_light: #6EBFC5;
    --text_muted: #4C8F95;
    --text_disabled: #4C8F95;
    --text_inactive: #6EBFC5;

    --border_color: #0D0F17;
    --border_radius: 0px;
    --border_radius_small: 0px;
    --border_radius_large: 0px;
    --highlight_width: 1px;
    --highlight_color: #7AD0D3;
    --border_highlight: #7AD0D3;

    --input_bg: #272B3E;
    --input_bg_hover: #393D55;
    --input_bg_focus: #12151E;
    --list_item_bg_selected: #31354D;
    --list_item_bg_hover: #393D55;
    --input_border: #404359;
    --input_border_hover: #4B6678;
    --input_border_focus: #7AD0D3;
    --button_bg: #31354D;
    --button_bg_hover: #393D55;
    --button_bg_down: #272B3E;
    --button_bg_disabled: #1F2431;
    --button_border: #31354D;
    --button_border_hover: #4B6678;
    --button_border_focus: #7AD0D3;
    --tab_bg: #31354D;
    --tab_bg_hover: #393D55;
    --tab_bg_down: #272B3E;
    --tab_bg_disabled: #1F2431;
    --tab_border: #404359;
    --tab_border_hover: #4B6678;
    --tab_border_focus: #7AD0D3;
    --tab_border_selected: #31354D;
    --scrollbar_handle: #31354D;
    --scrollbar_bg: #1F2431;
    --scrollbar_hover: #393D55;
    --scrollbar_down: #272B3E;
    --scrollbar_border: #0D0F17;
}

QWidget {
    font-family: Verdana;
    font-size: 12px;
}

QPushButton,
QToolButton {
    border: 2px solid;
    border-color: #4B6678 #0D0F17 #0D0F17 #4B6678;
    border-radius: 0px;
}

QPushButton:pressed,
QPushButton:checked,
QToolButton:pressed,
QToolButton:checked {
    border-color: #0D0F17 #4B6678 #4B6678 #0D0F17;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    border: 2px solid;
    border-color: #0D0F17 #4B6678 #4B6678 #0D0F17;
    border-radius: 0px;
}
