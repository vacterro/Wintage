    "activityBar.border": "#100E08",
    "activityBarBadge.background": "#008080",
    "activityBarBadge.foreground": "#1A1810",
    "sideBar.background": "#332E22",
    "sideBar.foreground": "#9C9371",
    "sideBar.border": "#100E08",
    "sideBar.dropBackground": "#3D372A",
    "sideBarTitle.foreground": "#D4C89A",
    "sideBarSectionHeader.background": "#3D372A",
    "sideBarSectionHeader.foreground": "#D4C89A",
    "sideBarSectionHeader.border": "#F0D060",
    "editorGroup.border": "#100E08",
    "editorGroup.dropBackground": "#3D372A88",
    "editorGroupHeader.noTabsBackground": "#332E22",
    "editorGroupHeader.tabsBackground": "#332E22",
    "editorGroupHeader.tabsBorder": "#100E08",
    "tab.activeBackground": "#332E22",
    "tab.activeForeground": "#D4C89A",
    "tab.border": "#100E08",
    "tab.activeBorder": "#F0D060",
    "tab.activeBorderTop": "#F0D060",
    "tab.inactiveBackground": "#3D372A",
    "tab.inactiveForeground": "#9C9371",
    "tab.hoverBackground": "#453D30",
    "editor.background": "#1A1810",
    "editor.foreground": "#D4C89A",
    "editorLineNumber.foreground": "#6E674E",
    "editorLineNumber.activeForeground": "#9C9371",
    "editorCursor.foreground": "#D4C89A",
    "editor.selectionBackground": "#3D372A",
    "editor.inactiveSelectionBackground": "#453D30",
    "editorWhitespace.foreground": "#5A5040",
    "editorIndentGuide.background": "#5A5040",
    "editorIndentGuide.activeBackground": "#6E674E",
    "panel.background": "#332E22",
    "panel.border": "#F0D060",
    "panelTitle.activeBorder": "#F0D060",
    "panelTitle.activeForeground": "#D4C89A",
    "panelTitle.inactiveForeground": "#9C9371",
    "statusBar.background": "#3D372A",
    "statusBar.foreground": "#D4C89A",
    "statusBar.border": "#F0D060",
    "statusBar.debuggingBackground": "#004C4C",
    "statusBar.debuggingForeground": "#D4C89A",
    "statusBar.noFolderBackground": "#3D372A",
    "statusBar.noFolderForeground": "#D4C89A",
    "titleBar.activeBackground": "#332E22",
    "titleBar.activeForeground": "#D4C89A",
    "titleBar.inactiveBackground": "#232018",
    "titleBar.inactiveForeground": "#6E674E",
    "titleBar.border": "#F0D060"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6E674E",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#4A7A20"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#008080"
      }
    },
    {
      "scope": [
        "entity",
        "entity.name"
      ],
      "settings": {
        "foreground": "#D4C89A",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "variable.parameter.function",
      "settings": {
        "foreground": "#9C9371"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#7A7A20"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#F0D060"
      }
    },
    {
      "scope": [
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#F0D060"
      }
    },
    {
      "scope": [
        "storage.modifier.package",
        "storage.modifier.import",
        "storage.type.java"
      ],
      "settings": {
        "foreground": "#D4C89A"
      }
    },
    {
      "scope": [
        "string.regexp",
        "string.regexp keyword.other"
      ],
      "settings": {
        "foreground": "#4A7A20"
      }
    },
    {
      "scope": "meta.object-literal.key",
      "settings": {
        "foreground": "#9C9371"
      }
    },
    {
      "scope": "support",
      "settings": {
        "foreground": "#008080"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#D4C89A"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#7A2020"
      }
    }
  ]
}
