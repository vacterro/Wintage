    "list.focusBackground": "#3D372A",
    "list.focusForeground": "#D4C89A",
    "list.highlightForeground": "#F0D060",
    "list.hoverBackground": "#453D30",
    "list.hoverForeground": "#D4C89A",
    "list.inactiveSelectionBackground": "#453D30",
    "list.inactiveSelectionForeground": "#D4C89A",
    "activityBar.background": "#453D30",
    "activityBar.dropBorder": "#D4C89A",
    "activityBar.foreground": "#D4C89A",
