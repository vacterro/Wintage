    "textBlockQuote.border": "#100E08",
    "textCodeBlock.background": "#1A1810",
    "textLink.activeForeground": "#F0D060",
    "textLink.foreground": "#D4C89A",
    "textPreformat.foreground": "#D4C89A",
    "textSeparator.foreground": "#100E08",
    "button.background": "#3D372A",
    "button.foreground": "#D4C89A",
    "button.hoverBackground": "#453D30",
    "button.secondaryBackground": "#332E22",
    "button.secondaryForeground": "#9C9371",
    "button.secondaryHoverBackground": "#3D372A",
    "button.border": "#F0D060",
    "dropdown.background": "#232018",
    "dropdown.listBackground": "#332E22",
    "dropdown.border": "#100E08",
    "dropdown.foreground": "#D4C89A",
    "input.background": "#232018",
    "input.border": "#100E08",
    "input.foreground": "#D4C89A",
    "input.placeholderForeground": "#6E674E",
    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.activeBackground": "#332E22",
    "scrollbarSlider.background": "#3D372A",
    "scrollbarSlider.hoverBackground": "#453D30",
    "badge.background": "#008080",
