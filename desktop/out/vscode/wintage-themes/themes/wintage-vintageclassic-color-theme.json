{
  "name": "Wintage Vintage Classic",
  "type": "dark",
  "colors": {
    "focusBorder": "#000000",
    "foreground": "#000000",
    "widget.shadow": "#00000000",
    "selection.background": "#D0D0D0",
    "descriptionForeground": "#3A3A3A",
    "errorForeground": "#7A2020",
    "textBlockQuote.background": "#C0C0C0",
    "textBlockQuote.border": "#808080",
    "textCodeBlock.background": "#C0C0C0",
    "textLink.activeForeground": "#5E7A7A",
    "textLink.foreground": "#000000",
    "textPreformat.foreground": "#000000",
    "textSeparator.foreground": "#808080",
    "button.background": "#D0D0D0",
    "button.foreground": "#000000",
    "button.hoverBackground": "#DCDCDC",
    "button.secondaryBackground": "#C0C0C0",
    "button.secondaryForeground": "#3A3A3A",
    "button.secondaryHoverBackground": "#D0D0D0",
    "button.border": "#5E7A7A",
    "dropdown.background": "#FFFFFF",
    "dropdown.listBackground": "#C0C0C0",
    "dropdown.border": "#808080",
    "dropdown.foreground": "#000000",
    "input.background": "#FFFFFF",
    "input.border": "#808080",
    "input.foreground": "#000000",
    "input.placeholderForeground": "#6A6A6A",
    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.activeBackground": "#C0C0C0",
    "scrollbarSlider.background": "#D0D0D0",
    "scrollbarSlider.hoverBackground": "#DCDCDC",
    "badge.background": "#008080",
    "badge.foreground": "#C0C0C0",
    "list.activeSelectionBackground": "#D0D0D0",
    "list.activeSelectionForeground": "#000000",
    "list.dropBackground": "#D0D0D0",
    "list.focusBackground": "#D0D0D0",
    "list.focusForeground": "#000000",
    "list.highlightForeground": "#5E7A7A",
    "list.hoverBackground": "#DCDCDC",
    "list.hoverForeground": "#000000",
    "list.inactiveSelectionBackground": "#DCDCDC",
    "list.inactiveSelectionForeground": "#000000",
    "activityBar.background": "#DCDCDC",
    "activityBar.dropBorder": "#000000",
    "activityBar.foreground": "#000000",
    "activityBar.inactiveForeground": "#6A6A6A",
    "activityBar.border": "#808080",
    "activityBarBadge.background": "#008080",
    "activityBarBadge.foreground": "#C0C0C0",
    "sideBar.background": "#C0C0C0",
    "sideBar.foreground": "#3A3A3A",
    "sideBar.border": "#808080",
    "sideBar.dropBackground": "#D0D0D0",
    "sideBarTitle.foreground": "#000000",
    "sideBarSectionHeader.background": "#D0D0D0",
    "sideBarSectionHeader.foreground": "#000000",
    "sideBarSectionHeader.border": "#5E7A7A",
    "editorGroup.border": "#808080",
    "editorGroup.dropBackground": "#D0D0D088",
    "editorGroupHeader.noTabsBackground": "#C0C0C0",
    "editorGroupHeader.tabsBackground": "#C0C0C0",
    "editorGroupHeader.tabsBorder": "#808080",
    "tab.activeBackground": "#C0C0C0",
    "tab.activeForeground": "#000000",
    "tab.border": "#808080",
    "tab.activeBorder": "#5E7A7A",
    "tab.activeBorderTop": "#5E7A7A",
    "tab.inactiveBackground": "#D0D0D0",
    "tab.inactiveForeground": "#3A3A3A",
    "tab.hoverBackground": "#DCDCDC",
    "editor.background": "#C0C0C0",
    "editor.foreground": "#000000",
    "editorLineNumber.foreground": "#6A6A6A",
    "editorLineNumber.activeForeground": "#3A3A3A",
    "editorCursor.foreground": "#000000",
    "editor.selectionBackground": "#D0D0D0",
    "editor.inactiveSelectionBackground": "#DCDCDC",
    "editorWhitespace.foreground": "#FFFFFF",
    "editorIndentGuide.background": "#FFFFFF",
    "editorIndentGuide.activeBackground": "#6A6A6A",
    "panel.background": "#C0C0C0",
    "panel.border": "#5E7A7A",
    "panelTitle.activeBorder": "#5E7A7A",
    "panelTitle.activeForeground": "#000000",
    "panelTitle.inactiveForeground": "#3A3A3A",
    "statusBar.background": "#D0D0D0",
    "statusBar.foreground": "#000000",
    "statusBar.border": "#5E7A7A",
    "statusBar.debuggingBackground": "#004C4C",
    "statusBar.debuggingForeground": "#000000",
    "statusBar.noFolderBackground": "#D0D0D0",
    "statusBar.noFolderForeground": "#000000",
    "titleBar.activeBackground": "#C0C0C0",
    "titleBar.activeForeground": "#000000",
    "titleBar.inactiveBackground": "#FFFFFF",
    "titleBar.inactiveForeground": "#6A6A6A",
    "titleBar.border": "#5E7A7A"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6A6A6A",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#4A7A20"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#008080"
      }
    },
    {
      "scope": [
        "entity",
        "entity.name"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "variable.parameter.function",
      "settings": {
        "foreground": "#3A3A3A"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#7A7A20"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#5E7A7A"
      }
    },
    {
      "scope": [
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#5E7A7A"
      }
    },
    {
      "scope": [
        "storage.modifier.package",
        "storage.modifier.import",
        "storage.type.java"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "string.regexp",
        "string.regexp keyword.other"
      ],
      "settings": {
        "foreground": "#4A7A20"
      }
    },
    {
      "scope": "meta.object-literal.key",
      "settings": {
        "foreground": "#3A3A3A"
      }
    },
    {
      "scope": "support",
      "settings": {
        "foreground": "#008080"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#7A2020"
      }
    }
  ]
}
