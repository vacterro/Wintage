    "editorCursor.foreground": "#C0C0C0",
    "editor.selectionBackground": "#343434",
    "editor.inactiveSelectionBackground": "#3A3A3A",
    "editorWhitespace.foreground": "#4D4D4D",
    "editorIndentGuide.background": "#4D4D4D",
