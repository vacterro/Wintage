    "list.focusForeground": "#A0E295",
    "list.highlightForeground": "#89D37A",
    "list.hoverBackground": "#3A4354",
    "list.hoverForeground": "#A0E295",
    "list.inactiveSelectionBackground": "#3A4354",
    "list.inactiveSelectionForeground": "#A0E295",
    "activityBar.background": "#3A4354",
    "activityBar.dropBorder": "#A0E295",
    "activityBar.foreground": "#A0E295",
    "activityBar.inactiveForeground": "#55954C",
    "activityBar.border": "#0E1116",
