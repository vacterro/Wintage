    "sideBar.background": "#28303D",
    "sideBar.foreground": "#7AC56E",
    "sideBar.border": "#0E1116",
    "sideBar.dropBackground": "#333B4B",
    "sideBarTitle.foreground": "#A0E295",
    "sideBarSectionHeader.background": "#333B4B",
    "sideBarSectionHeader.foreground": "#A0E295",
    "sideBarSectionHeader.border": "#89D37A",
    "editorGroup.border": "#0E1116",
    "editorGroup.dropBackground": "#333B4B88",
    "editorGroupHeader.noTabsBackground": "#28303D",
    "editorGroupHeader.tabsBackground": "#28303D",
    "editorGroupHeader.tabsBorder": "#0E1116",
    "tab.activeBackground": "#28303D",
    "tab.activeForeground": "#A0E295",
    "tab.border": "#0E1116",
    "tab.activeBorder": "#89D37A",
    "tab.activeBorderTop": "#89D37A",
    "tab.inactiveBackground": "#333B4B",
    "tab.inactiveForeground": "#7AC56E",
    "tab.hoverBackground": "#3A4354",
    "editor.background": "#1B232B",
    "editor.foreground": "#A0E295",
    "editorLineNumber.foreground": "#55954C",
    "editorLineNumber.activeForeground": "#7AC56E",
    "editorCursor.foreground": "#A0E295",
    "editor.selectionBackground": "#333B4B",
    "editor.inactiveSelectionBackground": "#3A4354",
    "editorWhitespace.foreground": "#414958",
    "editorIndentGuide.background": "#414958",
    "editorIndentGuide.activeBackground": "#55954C",
    "panel.background": "#28303D",
    "panel.border": "#89D37A",
    "panelTitle.activeBorder": "#89D37A",
    "panelTitle.activeForeground": "#A0E295",
    "panelTitle.inactiveForeground": "#7AC56E",
    "statusBar.background": "#333B4B",
    "statusBar.foreground": "#A0E295",
    "statusBar.border": "#89D37A",
    "statusBar.debuggingBackground": "#006060",
    "statusBar.debuggingForeground": "#A0E295",
    "statusBar.noFolderBackground": "#333B4B",
    "statusBar.noFolderForeground": "#A0E295",
    "titleBar.activeBackground": "#28303D",
    "titleBar.activeForeground": "#A0E295",
    "titleBar.inactiveBackground": "#202830",
    "titleBar.inactiveForeground": "#55954C",
    "titleBar.border": "#89D37A"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#55954C",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#5B9630"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#008080"
      }
    },
    {
      "scope": [
        "entity",
        "entity.name"
      ],
      "settings": {
        "foreground": "#A0E295",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "variable.parameter.function",
      "settings": {
        "foreground": "#7AC56E"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#969630"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#89D37A"
      }
    },
    {
      "scope": [
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#89D37A"
      }
    },
    {
      "scope": [
        "storage.modifier.package",
        "storage.modifier.import",
        "storage.type.java"
      ],
      "settings": {
        "foreground": "#A0E295"
      }
    },
    {
      "scope": [
        "string.regexp",
        "string.regexp keyword.other"
      ],
      "settings": {
        "foreground": "#5B9630"
      }
    },
    {
      "scope": "meta.object-literal.key",
      "settings": {
        "foreground": "#7AC56E"
      }
    },
    {
      "scope": "support",
      "settings": {
        "foreground": "#008080"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#A0E295"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#963030"
      }
    }
  ]
}
