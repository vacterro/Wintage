    "titleBar.inactiveForeground": "#3F7A38",
    "titleBar.border": "#70C060"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#3F7A38",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#4A7A20"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#008080"
      }
    },
    {
      "scope": [
        "entity",
        "entity.name"
      ],
      "settings": {
        "foreground": "#87D47A",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "variable.parameter.function",
      "settings": {
        "foreground": "#64B058"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#7A7A20"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#70C060"
      }
    },
    {
      "scope": [
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#70C060"
      }
    },
    {
      "scope": [
        "storage.modifier.package",
        "storage.modifier.import",
        "storage.type.java"
      ],
      "settings": {
        "foreground": "#87D47A"
      }
    },
    {
      "scope": [
        "string.regexp",
        "string.regexp keyword.other"
      ],
      "settings": {
        "foreground": "#4A7A20"
      }
    },
    {
      "scope": "meta.object-literal.key",
      "settings": {
        "foreground": "#64B058"
      }
    },
    {
      "scope": "support",
      "settings": {
        "foreground": "#008080"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#87D47A"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#7A2020"
      }
    }
  ]
}
