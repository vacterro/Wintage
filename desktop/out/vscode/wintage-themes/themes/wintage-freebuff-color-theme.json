    "textBlockQuote.border": "#0E1116",
    "textCodeBlock.background": "#1B232B",
    "textLink.activeForeground": "#89D37A",
    "textLink.foreground": "#A0E295",
    "textPreformat.foreground": "#A0E295",
    "textSeparator.foreground": "#0E1116",
    "button.background": "#333B4B",
    "button.foreground": "#A0E295",
    "button.hoverBackground": "#3A4354",
    "button.secondaryBackground": "#28303D",
    "button.secondaryForeground": "#7AC56E",
    "button.secondaryHoverBackground": "#333B4B",
    "button.border": "#89D37A",
    "dropdown.background": "#202830",
    "dropdown.listBackground": "#28303D",
    "dropdown.border": "#0E1116",
    "dropdown.foreground": "#A0E295",
    "input.background": "#202830",
    "input.border": "#0E1116",
    "input.foreground": "#A0E295",
    "input.placeholderForeground": "#55954C",
    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.activeBackground": "#28303D",
