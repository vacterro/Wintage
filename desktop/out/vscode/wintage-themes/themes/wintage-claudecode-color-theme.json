    "titleBar.activeForeground": "#D2A57C",
    "titleBar.inactiveBackground": "#17150F",
    "titleBar.inactiveForeground": "#785A3A",
    "titleBar.border": "#BE8B62"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#785A3A",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#4A7A20"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#008080"
      }
    },
    {
      "scope": [
        "entity",
        "entity.name"
      ],
      "settings": {
        "foreground": "#D2A57C",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "variable.parameter.function",
      "settings": {
        "foreground": "#AE825A"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#7A7A20"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#BE8B62"
      }
    },
    {
      "scope": [
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#BE8B62"
      }
    },
    {
      "scope": [
        "storage.modifier.package",
        "storage.modifier.import",
        "storage.type.java"
      ],
      "settings": {
        "foreground": "#D2A57C"
      }
    },
    {
      "scope": [
        "string.regexp",
        "string.regexp keyword.other"
      ],
      "settings": {
        "foreground": "#4A7A20"
      }
    },
    {
      "scope": "meta.object-literal.key",
      "settings": {
        "foreground": "#AE825A"
      }
    },
    {
      "scope": "support",
      "settings": {
        "foreground": "#008080"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#D2A57C"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#7A2020"
      }
    }
  ]
}
