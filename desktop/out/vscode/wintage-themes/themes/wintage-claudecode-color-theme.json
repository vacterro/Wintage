    "tab.activeForeground": "#D2A57C",
    "tab.border": "#0A0907",
    "tab.activeBorder": "#BE8B62",
    "tab.activeBorderTop": "#BE8B62",
    "tab.inactiveBackground": "#2A281E",
    "tab.inactiveForeground": "#AE825A",
    "tab.hoverBackground": "#2E2B21",
    "editor.background": "#13110C",
    "editor.foreground": "#D2A57C",
    "editorLineNumber.foreground": "#785A3A",
    "editorLineNumber.activeForeground": "#AE825A",
    "editorCursor.foreground": "#D2A57C",
    "editor.selectionBackground": "#2A281E",
    "editor.inactiveSelectionBackground": "#2E2B21",
    "editorWhitespace.foreground": "#3C392E",
    "editorIndentGuide.background": "#3C392E",
    "editorIndentGuide.activeBackground": "#785A3A",
    "panel.background": "#201D14",
    "panel.border": "#BE8B62",
    "panelTitle.activeBorder": "#BE8B62",
    "panelTitle.activeForeground": "#D2A57C",
    "panelTitle.inactiveForeground": "#AE825A",
    "statusBar.background": "#2A281E",
    "statusBar.foreground": "#D2A57C",
    "statusBar.border": "#BE8B62",
    "statusBar.debuggingBackground": "#004C4C",
    "statusBar.debuggingForeground": "#D2A57C",
    "statusBar.noFolderBackground": "#2A281E",
    "statusBar.noFolderForeground": "#D2A57C",
