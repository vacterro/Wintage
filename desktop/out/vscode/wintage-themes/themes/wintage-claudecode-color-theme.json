  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#93704E",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#5B9630"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#008080"
      }
    },
    {
      "scope": [
        "entity",
        "entity.name"
      ],
      "settings": {
        "foreground": "#E0B997",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "variable.parameter.function",
      "settings": {
        "foreground": "#C39870"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#969630"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#D1A27C"
      }
    },
    {
      "scope": [
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#D1A27C"
      }
    },
    {
      "scope": [
        "storage.modifier.package",
        "storage.modifier.import",
        "storage.type.java"
      ],
      "settings": {
        "foreground": "#E0B997"
      }
    },
    {
      "scope": [
        "string.regexp",
        "string.regexp keyword.other"
      ],
      "settings": {
        "foreground": "#5B9630"
      }
    },
    {
      "scope": "meta.object-literal.key",
      "settings": {
        "foreground": "#C39870"
      }
    },
    {
      "scope": "support",
      "settings": {
        "foreground": "#008080"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#E0B997"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#963030"
      }
    }
  ]
}
