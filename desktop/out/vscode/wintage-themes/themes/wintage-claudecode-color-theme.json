    "sideBarTitle.foreground": "#D2A57C",
    "sideBarSectionHeader.background": "#2A281E",
    "sideBarSectionHeader.foreground": "#D2A57C",
    "sideBarSectionHeader.border": "#BE8B62",
    "editorGroup.border": "#0A0907",
    "editorGroup.dropBackground": "#2A281E88",
    "editorGroupHeader.noTabsBackground": "#201D14",
    "editorGroupHeader.tabsBackground": "#201D14",
    "editorGroupHeader.tabsBorder": "#0A0907",
