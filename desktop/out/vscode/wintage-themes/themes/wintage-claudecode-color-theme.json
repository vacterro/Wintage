    "button.secondaryBackground": "#201D14",
    "button.secondaryForeground": "#AE825A",
    "button.secondaryHoverBackground": "#2A281E",
    "button.border": "#BE8B62",
    "dropdown.background": "#17150F",
    "dropdown.listBackground": "#201D14",
    "dropdown.border": "#0A0907",
    "dropdown.foreground": "#D2A57C",
    "input.background": "#17150F",
    "input.border": "#0A0907",
    "input.foreground": "#D2A57C",
    "input.placeholderForeground": "#785A3A",
    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.activeBackground": "#201D14",
