  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#523B77",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#4A7A20"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#008080"
      }
    },
    {
      "scope": [
        "entity",
        "entity.name"
      ],
      "settings": {
        "foreground": "#9A7FD0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "variable.parameter.function",
      "settings": {
        "foreground": "#8B74B8"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#7A7A20"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#8C73C1"
      }
    },
    {
      "scope": [
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#8C73C1"
      }
    },
    {
      "scope": [
        "storage.modifier.package",
        "storage.modifier.import",
        "storage.type.java"
      ],
      "settings": {
        "foreground": "#9A7FD0"
      }
    },
    {
      "scope": [
        "string.regexp",
        "string.regexp keyword.other"
      ],
      "settings": {
        "foreground": "#4A7A20"
      }
    },
    {
      "scope": "meta.object-literal.key",
      "settings": {
        "foreground": "#8B74B8"
      }
    },
    {
      "scope": "support",
      "settings": {
        "foreground": "#008080"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#9A7FD0"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#7A2020"
      }
    }
  ]
}
