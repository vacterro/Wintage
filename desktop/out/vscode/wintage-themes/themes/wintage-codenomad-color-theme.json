{
  "name": "Wintage CodeNomad",
  "type": "dark",
  "colors": {
    "focusBorder": "#B099DE",
    "foreground": "#B099DE",
    "widget.shadow": "#00000000",
    "selection.background": "#343D4A",
    "descriptionForeground": "#9C84C8",
    "errorForeground": "#963030",
    "textBlockQuote.background": "#29313C",
    "textBlockQuote.border": "#0E1216",
    "textCodeBlock.background": "#1C242A",
    "textLink.activeForeground": "#9D86D1",
    "textLink.foreground": "#B099DE",
    "textPreformat.foreground": "#B099DE",
    "textSeparator.foreground": "#0E1216",
    "button.background": "#343D4A",
    "button.foreground": "#B099DE",
    "button.hoverBackground": "#3C4552",
    "button.secondaryBackground": "#29313C",
    "button.secondaryForeground": "#9C84C8",
    "button.secondaryHoverBackground": "#343D4A",
    "button.border": "#9D86D1",
    "dropdown.background": "#21282F",
    "dropdown.listBackground": "#29313C",
    "dropdown.border": "#0E1216",
    "dropdown.foreground": "#B099DE",
    "input.background": "#21282F",
    "input.border": "#0E1216",
    "input.foreground": "#B099DE",
    "input.placeholderForeground": "#675091",
    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.activeBackground": "#29313C",
    "scrollbarSlider.background": "#343D4A",
    "scrollbarSlider.hoverBackground": "#3C4552",
    "badge.background": "#008080",
    "badge.foreground": "#1C242A",
    "list.activeSelectionBackground": "#343D4A",
    "list.activeSelectionForeground": "#B099DE",
    "list.dropBackground": "#343D4A",
    "list.focusBackground": "#343D4A",
    "list.focusForeground": "#B099DE",
    "list.highlightForeground": "#9D86D1",
    "list.hoverBackground": "#3C4552",
    "list.hoverForeground": "#B099DE",
    "list.inactiveSelectionBackground": "#3C4552",
    "list.inactiveSelectionForeground": "#B099DE",
    "activityBar.background": "#3C4552",
    "activityBar.dropBorder": "#B099DE",
    "activityBar.foreground": "#B099DE",
    "activityBar.inactiveForeground": "#675091",
    "activityBar.border": "#0E1216",
    "activityBarBadge.background": "#008080",
    "activityBarBadge.foreground": "#1C242A",
    "sideBar.background": "#29313C",
    "sideBar.foreground": "#9C84C8",
    "sideBar.border": "#0E1216",
    "sideBar.dropBackground": "#343D4A",
    "sideBarTitle.foreground": "#B099DE",
    "sideBarSectionHeader.background": "#343D4A",
    "sideBarSectionHeader.foreground": "#B099DE",
    "sideBarSectionHeader.border": "#9D86D1",
    "editorGroup.border": "#0E1216",
    "editorGroup.dropBackground": "#343D4A88",
    "editorGroupHeader.noTabsBackground": "#29313C",
    "editorGroupHeader.tabsBackground": "#29313C",
    "editorGroupHeader.tabsBorder": "#0E1216",
    "tab.activeBackground": "#29313C",
    "tab.activeForeground": "#B099DE",
    "tab.border": "#0E1216",
    "tab.activeBorder": "#9D86D1",
    "tab.activeBorderTop": "#9D86D1",
    "tab.inactiveBackground": "#343D4A",
    "tab.inactiveForeground": "#9C84C8",
    "tab.hoverBackground": "#3C4552",
    "editor.background": "#1C242A",
    "editor.foreground": "#B099DE",
    "editorLineNumber.foreground": "#675091",
    "editorLineNumber.activeForeground": "#9C84C8",
    "editorCursor.foreground": "#B099DE",
    "editor.selectionBackground": "#343D4A",
    "editor.inactiveSelectionBackground": "#3C4552",
    "editorWhitespace.foreground": "#424A57",
    "editorIndentGuide.background": "#424A57",
    "editorIndentGuide.activeBackground": "#675091",
    "panel.background": "#29313C",
    "panel.border": "#9D86D1",
    "panelTitle.activeBorder": "#9D86D1",
    "panelTitle.activeForeground": "#B099DE",
    "panelTitle.inactiveForeground": "#9C84C8",
    "statusBar.background": "#343D4A",
    "statusBar.foreground": "#B099DE",
    "statusBar.border": "#9D86D1",
    "statusBar.debuggingBackground": "#006060",
    "statusBar.debuggingForeground": "#B099DE",
    "statusBar.noFolderBackground": "#343D4A",
    "statusBar.noFolderForeground": "#B099DE",
    "titleBar.activeBackground": "#29313C",
    "titleBar.activeForeground": "#B099DE",
    "titleBar.inactiveBackground": "#21282F",
    "titleBar.inactiveForeground": "#675091",
    "titleBar.border": "#9D86D1"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#675091",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#5B9630"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#008080"
      }
    },
    {
      "scope": [
        "entity",
        "entity.name"
      ],
      "settings": {
        "foreground": "#B099DE",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "variable.parameter.function",
      "settings": {
        "foreground": "#9C84C8"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#969630"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#9D86D1"
      }
    },
    {
      "scope": [
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#9D86D1"
      }
    },
    {
      "scope": [
        "storage.modifier.package",
        "storage.modifier.import",
        "storage.type.java"
      ],
      "settings": {
        "foreground": "#B099DE"
      }
    },
    {
      "scope": [
        "string.regexp",
        "string.regexp keyword.other"
      ],
      "settings": {
        "foreground": "#5B9630"
      }
    },
    {
      "scope": "meta.object-literal.key",
      "settings": {
        "foreground": "#9C84C8"
      }
    },
    {
      "scope": "support",
      "settings": {
        "foreground": "#008080"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#B099DE"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#963030"
      }
    }
  ]
}
