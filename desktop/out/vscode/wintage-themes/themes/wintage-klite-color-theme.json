  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6D6F74",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#5B9630"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#008080"
      }
    },
    {
      "scope": [
        "entity",
        "entity.name"
      ],
      "settings": {
        "foreground": "#B8BABF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "variable.parameter.function",
      "settings": {
        "foreground": "#95989E"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#969630"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#A2A5AB"
      }
    },
    {
      "scope": [
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#A2A5AB"
      }
    },
    {
      "scope": [
        "storage.modifier.package",
        "storage.modifier.import",
        "storage.type.java"
      ],
      "settings": {
        "foreground": "#B8BABF"
      }
    },
    {
      "scope": [
        "string.regexp",
        "string.regexp keyword.other"
      ],
      "settings": {
        "foreground": "#5B9630"
      }
    },
    {
      "scope": "meta.object-literal.key",
      "settings": {
        "foreground": "#95989E"
      }
    },
    {
      "scope": "support",
      "settings": {
        "foreground": "#008080"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#B8BABF"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#963030"
      }
    }
  ]
}
