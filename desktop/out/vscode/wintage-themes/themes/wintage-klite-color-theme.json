    "textCodeBlock.background": "#0E1011",
    "textLink.activeForeground": "#8B8E95",
    "textLink.foreground": "#A3A5AC",
    "textPreformat.foreground": "#A3A5AC",
    "textSeparator.foreground": "#080909",
    "button.background": "#222426",
    "button.foreground": "#A3A5AC",
    "button.hoverBackground": "#25272A",
    "button.secondaryBackground": "#181A1C",
    "button.secondaryForeground": "#808288",
    "button.secondaryHoverBackground": "#222426",
    "button.border": "#8B8E95",
    "dropdown.background": "#121314",
    "dropdown.listBackground": "#181A1C",
    "dropdown.border": "#080909",
    "dropdown.foreground": "#A3A5AC",
    "input.background": "#121314",
    "input.border": "#080909",
    "input.foreground": "#A3A5AC",
    "input.placeholderForeground": "#56575C",
    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.activeBackground": "#181A1C",
