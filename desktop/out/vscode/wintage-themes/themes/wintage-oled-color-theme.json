    "button.secondaryBackground": "#0A0A0A",
    "button.secondaryForeground": "#777777",
    "button.secondaryHoverBackground": "#141414",
    "button.border": "#FFFFFF",
    "dropdown.background": "#000000",
    "dropdown.listBackground": "#0A0A0A",
    "dropdown.border": "#1A1A1A",
    "dropdown.foreground": "#A0A0A0",
    "input.background": "#000000",
    "input.border": "#1A1A1A",
    "input.foreground": "#A0A0A0",
